    "# SQL - Aggregation Functions\n",
    "\n",
    "### SQL TASK \n",
    "\n",
    "```SQL\n",
    "SELECT\n",
    "    COUNT(*) AS total_nr_orders,\n",
    "    SUM(sales) AS total_sales,\n",
    "    AVG(sales) AS avg_sales,\n",
    "    MAX(sales) AS highest_sales,\n",
    "    MIN(sales) AS lowest_sales\n",
    "FROM sales.orders;\n",
    "```"
   ]
  }
 ],
